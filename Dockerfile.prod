# Produção (Build local transferido via deploy-vps.ps1)
FROM node:20-slim

RUN apt-get update -y && apt-get install -y openssl libssl-dev
WORKDIR /usr/src/app

# Instala apenas dependências de produção para salvar memória
COPY package*.json ./
COPY prisma ./prisma/
RUN npm install --omit=dev
RUN npx prisma generate

# Copia os arquivos gerados localmente (pelo deploy-vps.ps1)
COPY dist ./dist

EXPOSE 3001

CMD ["sh", "-c", "npx prisma db push --accept-data-loss && node dist/src/main"]
